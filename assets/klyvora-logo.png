<svg xmlns="http://www.w3.org/2000/svg" width="600" height="220" viewBox="0 0 600 220">
  <defs>
    <linearGradient id="purpleBlue" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#d8b4fe"/>
      <stop offset="50%" stop-color="#9333ea"/>
      <stop offset="100%" stop-color="#2563eb"/>
    </linearGradient>
    <filter id="glow">
      <feGaussianBlur stdDeviation="4" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>

  <rect width="600" height="220" rx="18" fill="#080611"/>

  <g transform="translate(24 35)" filter="url(#glow)">
    <path d="M45 10 V145 M45 82 L135 10 M78 82 L145 145"
          fill="none" stroke="url(#purpleBlue)"
          stroke-width="15" stroke-linecap="square"
          stroke-linejoin="bevel"/>
    <ellipse cx="95" cy="77" rx="105" ry="35"
             transform="rotate(-22 95 77)"
             fill="none" stroke="#a855f7" stroke-width="4"/>
    <circle cx="178" cy="28" r="5" fill="#ffffff"/>
  </g>

  <text x="245" y="105"
        font-family="Arial, sans-serif"
        font-size="57"
        font-weight="bold"
        letter-spacing="5"
        fill="url(#purpleBlue)">KLYVORA</text>

  <path d="M245 125 H555" stroke="#9333ea" stroke-width="2"/>

  <text x="245" y="155"
        font-family="Arial, sans-serif"
        font-size="14"
        letter-spacing="4"
        fill="#d8b4fe">YOUR VISION. OUR CREATION.</text>
</svg>
